DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Africa/Kampala

POSTGRES_DB=iles
